{
  "expo": {
    "name": "WumpusAdventures",
    "slug": "wumpusadventures",
    "description": "Descend a haunted cave, read the clues, grab the gems and slay the Wumpus. A bite-sized deduction roguelite.",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#140F2A",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "wumpus",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.cuencaoscar.wumpusadventures",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#140F2A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cuencaoscar.wumpusadventures",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#FFD54F"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-native.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0E0B1F"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b9fbe4ad-63fa-435d-bf05-fee2ac704ea5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b9fbe4ad-63fa-435d-bf05-fee2ac704ea5"
    }
  }
}
