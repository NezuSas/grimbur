{
  "expo": {
    "name": "WumpusAdventures",
    "slug": "wumpusadventures",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "wumpus",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuencaoscar.wumpusadventures"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cuencaoscar.wumpusadventures",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b9fbe4ad-63fa-435d-bf05-fee2ac704ea5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b9fbe4ad-63fa-435d-bf05-fee2ac704ea5"
    }
  }
}
