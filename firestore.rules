rules_version = '2';

// Public leaderboard. Anyone can read; anyone can append a well-formed score;
// nobody can edit or delete. Limits mirror src/core/leaderboard/validation.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isInt(v) { return v is int; }

    function validScore(d) {
      return d.keys().hasOnly(['level', 'score', 'name', 'coins', 'characterIndex', 'time'])
        && d.keys().hasAll(['level', 'score', 'name', 'coins', 'characterIndex', 'time'])
        && isInt(d.level) && d.level >= 1 && d.level <= 12
        && isInt(d.score) && d.score >= 0 && d.score <= d.level * 20000
        && isInt(d.coins) && d.coins >= 0 && d.coins <= d.level * 8
        && isInt(d.characterIndex) && d.characterIndex >= 0 && d.characterIndex < 6
        && isInt(d.time) && d.time >= 1 && d.time <= 86400
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validName(d.name)
        // A floor takes a few seconds at the very least: a run of N floors in one second is not a play.
        && d.time >= (d.level - 1) * 5 + 1;
    }

    // The client cleans names (src/core/leaderboard/validation.ts); the server enforces the parts that matter if someone writes
    // straight to the database: no control or direction-changing characters, no links, not only spaces.
    function validName(n) {
      return n.trim().size() >= 1
        && n.matches('^[^\\x00-\\x1f\\x7f\\x{200b}-\\x{200f}\\x{202a}-\\x{202e}\\x{2066}-\\x{2069}]+$')
        && !n.lower().matches('.*(http|www\\.|://).*');
    }

    match /highscores/{scoreId} {
      // At most 20 rows per query: the app reads the top 20.
      allow read: if request.query.limit <= 20;
      allow create: if validScore(request.resource.data);
      allow update, delete: if false;
    }

    // Cloud backup of a player's progress. The document id is a random 16-character recovery key that only its owner knows (80 bits,
    // shown in Settings): whoever holds the key may read, write and delete that one document; nobody can list or guess them.
    function validKey(k) { return k.matches('^[0-9A-HJKMNP-TV-Z]{16}$'); }

    match /backups/{key} {
      allow get: if validKey(key);
      allow create, update: if validKey(key)
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.keys().hasAll(['code', 'updatedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 20 && request.resource.data.code.size() <= 30000
        && request.resource.data.code.matches('^WA[0-9]+\\.[A-Za-z0-9_.-]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if validKey(key);
      allow list: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
