rules_version = '2';

// Public leaderboard. Anyone can read; each player keeps one well-formed row (their auth uid) that only a better score
// replaces; nobody can delete. Limits mirror src/core/leaderboard/validation.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isInt(v) { return v is int; }

    // Every write comes from a signed-in (anonymous) player, and a row's `pid` is its writer's auth uid:
    // nobody can create or edit another player's row, however well-formed the data.
    function isOwner(p) { return request.auth != null && request.auth.uid == p; }
    function validPid(p) { return p is string && p.matches('^[A-Za-z0-9]{10,64}$'); }

    // A row may carry the player's equipped frame and title (looks only, never ranking power): optional, and only ids of the
    // right shape (src/core/cosmetics/look.ts).
    function validLook(d) {
      return (!('frame' in d) || (d.frame is string && d.frame.matches('^frame_[a-z]{3,12}$')))
        && (!('title' in d) || (d.title is string && d.title.matches('^title_[a-z]{3,12}$')));
    }

    function validScore(d) {
      return d.keys().hasOnly(['level', 'score', 'name', 'coins', 'characterIndex', 'time', 'frame', 'title'])
        && d.keys().hasAll(['level', 'score', 'name', 'coins', 'characterIndex', 'time'])
        && validLook(d)
        && isInt(d.level) && d.level >= 1 && d.level <= 10
        && isInt(d.score) && d.score >= 0 && d.score <= d.level * 20000
        && isInt(d.coins) && d.coins >= 0 && d.coins <= d.level * 8
        && isInt(d.characterIndex) && d.characterIndex >= 0 && d.characterIndex < 6
        && isInt(d.time) && d.time >= 1 && d.time <= 86400
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validName(d.name)
        // A floor takes a few seconds at the very least: a run of N floors in one second is not a play.
        && d.time >= (d.level - 1) * 5 + 1;
    }

    // The client cleans names (src/core/leaderboard/validation.ts); the server enforces the parts that matter if someone writes
    // straight to the database: no control or direction-changing characters, no links, not only spaces.
    function validName(n) {
      return n.trim().size() >= 1
        && n.matches('^[^\\x00-\\x1f\\x7f\\x{200b}-\\x{200f}\\x{202a}-\\x{202e}\\x{2066}-\\x{2069}]+$')
        && !n.lower().matches('.*(http|www\\.|://).*');
    }

    // One row per player, keyed by their auth uid: a player cannot fill the board with copies of themselves.
    match /highscores/{uid} {
      // At most 20 rows per query: the app reads the top 20.
      allow list: if request.query.limit <= 20;
      allow get: if true;
      allow create: if isOwner(uid) && validScore(request.resource.data);
      allow update: if isOwner(uid) && validScore(request.resource.data) && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // Cloud backup of a player's progress. The document id is a random 16-character recovery key that only its owner knows (80 bits,
    // shown in Settings): whoever holds the key may read, write and delete that one document; nobody can list or guess them.
    function validKey(k) { return k.matches('^[0-9A-HJKMNP-TV-Z]{16}$'); }

    match /backups/{key} {
      allow get: if validKey(key);
      allow create, update: if validKey(key)
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.keys().hasAll(['code', 'updatedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 20 && request.resource.data.code.size() <= 30000
        && request.resource.data.code.matches('^WA[0-9]+\\.[A-Za-z0-9_.-]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if validKey(key);
      allow list: if false;
    }

    // Daily and weekly boards: one document per player per day (`<day>_<playerId>`). Replaying the day can only raise the score. The
    // weekly board reads the same documents for the seven days of the week (`day in [...]`), so there is no week to forge.
    // Limits mirror src/core/leaderboard/daily.ts.
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function dayOf(t) { return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day()); }
    // Local days may be a day ahead of or behind the server's (UTC): anything else is a made-up day.
    function recentDay(d) {
      return d == dayOf(request.time)
        || d == dayOf(request.time - duration.value(1, 'd'))
        || d == dayOf(request.time + duration.value(1, 'd'));
    }

    function validDaily(d, id) {
      return d.keys().hasOnly(['day', 'pid', 'name', 'level', 'score', 'coins', 'characterIndex', 'time', 'frame', 'title'])
        && d.keys().hasAll(['day', 'pid', 'name', 'level', 'score', 'coins', 'characterIndex', 'time'])
        && validLook(d)
        && d.day is string && d.day.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && recentDay(d.day)
        && validPid(d.pid)
        && id == d.day + '_' + d.pid
        && isInt(d.level) && d.level >= 1 && d.level <= 10
        && isInt(d.score) && d.score >= 0 && d.score <= d.level * 20000
        && isInt(d.coins) && d.coins >= 0 && d.coins <= d.level * 8
        && isInt(d.characterIndex) && d.characterIndex >= 0 && d.characterIndex < 6
        && isInt(d.time) && d.time >= (d.level - 1) * 5 + 1 && d.time <= 86400
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validName(d.name);
    }

    match /daily_scores/{id} {
      allow list: if request.query.limit <= 20;
      allow get: if true;
      allow create: if validDaily(request.resource.data, id) && isOwner(request.resource.data.pid);
      allow update: if validDaily(request.resource.data, id) && isOwner(resource.data.pid) && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // Friend challenges: one document per player per challenge code (`<code>_<playerId>`); a replay can only raise the score.
    // Limits mirror src/core/challenge and src/core/leaderboard/daily.ts.
    function validChallenge(d, id) {
      return d.keys().hasOnly(['code', 'pid', 'name', 'level', 'score', 'coins', 'characterIndex', 'time', 'frame', 'title'])
        && d.keys().hasAll(['code', 'pid', 'name', 'level', 'score', 'coins', 'characterIndex', 'time'])
        && validLook(d)
        && d.code is string && d.code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && validPid(d.pid)
        && id == d.code + '_' + d.pid
        && isInt(d.level) && d.level >= 1 && d.level <= 10
        && isInt(d.score) && d.score >= 0 && d.score <= d.level * 20000
        && isInt(d.coins) && d.coins >= 0 && d.coins <= d.level * 8
        && isInt(d.characterIndex) && d.characterIndex >= 0 && d.characterIndex < 6
        && isInt(d.time) && d.time >= (d.level - 1) * 5 + 1 && d.time <= 86400
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validName(d.name);
    }

    match /challenge_scores/{id} {
      allow list: if request.query.limit <= 20;
      allow get: if true;
      allow create: if validChallenge(request.resource.data, id) && isOwner(request.resource.data.pid);
      allow update: if validChallenge(request.resource.data, id) && isOwner(resource.data.pid) && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // Duel rooms: `duels/{code}` holds the stake the creator chose. It is written once and never changed, and every player of the room
    // must play for exactly that stake, so somebody who joins cannot raise the pot. A rematch room is created by whoever arrives first.
    match /duels/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && request.resource.data.keys().hasOnly(['code', 'host', 'stake', 'createdAt'])
        && request.resource.data.keys().hasAll(['code', 'host', 'stake', 'createdAt'])
        && request.resource.data.code == code
        && isOwner(request.resource.data.host)
        && isInt(request.resource.data.stake) && request.resource.data.stake >= 0 && request.resource.data.stake <= 100000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Live duels: each player keeps one document `<code>_<playerId>` that they update while they play and the rival listens to.
    // Limits mirror src/core/duel/duel.ts. `updatedAt` is the server's time: it is how the rival knows someone is still there.
    // `startedAt` is stamped with the server's time on every lobby/ready write and frozen once the run starts: a floor is only
    // believed when there has been time to reach it.
    function validDuel(d, id) {
      return d.keys().hasOnly(['code', 'pid', 'name', 'characterIndex', 'state', 'level', 'score', 'victory', 'time', 'stake', 'updatedAt', 'startedAt', 'frame', 'title'])
        && d.keys().hasAll(['code', 'pid', 'name', 'characterIndex', 'state', 'level', 'score', 'victory', 'time', 'stake', 'updatedAt', 'startedAt'])
        && validLook(d)
        && d.code is string && d.code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && validPid(d.pid)
        && id == d.code + '_' + d.pid
        && d.state in ['lobby', 'ready', 'playing', 'done']
        && isInt(d.level) && d.level >= 1 && d.level <= 10
        && isInt(d.score) && d.score >= 0 && d.score <= d.level * 20000
        && isInt(d.characterIndex) && d.characterIndex >= 0 && d.characterIndex < 6
        && d.victory is bool
        && isInt(d.time) && d.time >= 0 && d.time <= 86400
        && isInt(d.stake) && d.stake >= 0 && d.stake <= 100000
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validName(d.name)
        && d.updatedAt == request.time
        && d.startedAt is timestamp
        // The stake is the room's (see /duels): nobody plays for another one.
        && d.stake == get(/databases/$(database)/documents/duels/$(d.code)).data.stake
        // Before the run nothing has been played; only the last floor can be won.
        && (d.state in ['playing', 'done'] || (d.level == 1 && d.score == 0 && d.victory == false && d.startedAt == request.time))
        && (!d.victory || (d.state == 'done' && d.level == 10))
        // A floor takes a few seconds at the very least.
        && (d.state in ['lobby', 'ready'] || request.time >= d.startedAt + duration.value((d.level - 1) * 5, 's'));
    }

    function stateRank(s) { return {'lobby': 0, 'ready': 1, 'playing': 2, 'done': 3}[s]; }

    match /duel_players/{id} {
      // Up to 4 rows of a room are listed (two players and room for a stray one).
      allow list: if request.query.limit <= 4;
      allow get: if true;
      // A player enters a room in the lobby (or ready), never straight into a run.
      allow create: if validDuel(request.resource.data, id)
        && isOwner(request.resource.data.pid)
        && request.resource.data.state in ['lobby', 'ready'];
      // The player stays the same; the state only moves forward (lobby and ready may swap: "not ready any more" is allowed); the
      // run's start time, floor and score never go back; `done` is final.
      allow update: if validDuel(request.resource.data, id)
        && isOwner(resource.data.pid)
        && request.resource.data.code == resource.data.code
        && request.resource.data.pid == resource.data.pid
        && (resource.data.state in ['lobby', 'ready'] || stateRank(request.resource.data.state) >= stateRank(resource.data.state))
        && (resource.data.state in ['lobby', 'ready'] || request.resource.data.startedAt == resource.data.startedAt)
        && request.resource.data.level >= resource.data.level
        && request.resource.data.score >= resource.data.score
        && (resource.data.state != 'done' || (
          request.resource.data.state == 'done'
          && request.resource.data.level == resource.data.level
          && request.resource.data.score == resource.data.score
          && request.resource.data.victory == resource.data.victory
          && request.resource.data.time == resource.data.time));
      allow delete: if false;
    }

    // Crash reports: the app may only add one (signed in, strict shape); only the console ever reads them.
    match /crashes/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'stack', 'context', 'version', 'platform', 'at', 'receivedAt'])
        && request.resource.data.keys().hasAll(['message', 'stack', 'context', 'version', 'platform', 'at', 'receivedAt'])
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 4000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 4000
        && request.resource.data.context is string && request.resource.data.context.size() <= 40
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 40
        && request.resource.data.at is int && request.resource.data.at >= 0
        && request.resource.data.receivedAt == request.time;
      allow read, update, delete: if false;
    }

    // A notice from the developer, edited by hand in the console: the app reads it and cannot change it.
    match /config/{docId} {
      allow get: if docId == 'live' || docId == 'app';
      allow list, write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
